# ============================================================================
# CareerMate environment
#
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real keys.
#
# On Vercel, add every REQUIRED variable below under
# Project -> Settings -> Environment Variables.
# ============================================================================


# ---------------------------------------------------------------------------
# REQUIRED — Supabase database
#
# Supabase dashboard -> your project -> Connect (top bar) -> ORMs tab -> Prisma.
# It shows both strings. DATABASE_URL is the pooled (port 6543) connection that
# serverless functions must use; DIRECT_URL is the direct (port 5432) connection
# that migrations need.
#
# Replace [YOUR-PASSWORD] with the database password you set when you created
# the project. If you have lost it: Settings -> Database -> Reset database
# password.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"


# ---------------------------------------------------------------------------
# REQUIRED — Supabase auth and storage
#
# Supabase dashboard -> Settings -> API Keys.
#   NEXT_PUBLIC_SUPABASE_URL      = "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = "anon public" key (safe in the browser)
#   SUPABASE_SERVICE_ROLE_KEY     = "service_role" key
#
# The service role key bypasses Row Level Security. It is used only on the
# server, for minting signed CV download URLs and writing to storage. Never
# prefix it with NEXT_PUBLIC_ and never paste it into client code.
#
# You also need a Storage bucket named `resumes`, with "Public bucket" OFF.
# Storage -> New bucket. A public one would make every CV readable by URL.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""


# ---------------------------------------------------------------------------
# OPTIONAL — AI providers (P2)
#
# Every one of these is optional. A provider counts as available only when its
# key is present, and the router tries them in order, moving to the next on a
# rate limit, an exhausted quota, a server error or a malformed response. With
# no keys at all the app still works: it falls through to a deterministic local
# provider and labels its answers as a fallback rather than passing them off as
# model output.
#
# Sign up for as many free tiers as you like — that is the point of the chain.
#
#   GOOGLE_AI_API_KEY   https://aistudio.google.com/apikey        (most generous free tier)
#   GROQ_API_KEY        https://console.groq.com/keys             (free, very fast)
#   MISTRAL_API_KEY     https://console.mistral.ai/api-keys       (free tier)
#   OPENROUTER_API_KEY  https://openrouter.ai/keys                (has :free models)
#
# Which provider answered is shown on every AI panel, and every request is
# recorded in the AiInteraction table with the providers that failed first.
# ---------------------------------------------------------------------------
GOOGLE_AI_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
OPENROUTER_API_KEY=""

# Override the failover order. Comma-separated provider ids, highest priority
# first. Unset means: gemini,groq,mistral,openrouter,mock
# AI_PROVIDER_ORDER="groq,gemini,mock"

# OpenRouter only: pick a different model. Defaults to a free Llama 3.3.
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
